SETUP_CMD     = go mod download
BUILD_CMD     = go build ./...
TEST_CMD      = go test ./...
TEST_ONE_CMD  = go test -run '$(RUN)' ./...
LINT_CMD      = go vet ./...
FMT_CMD       = gofmt -w .
# `gofmt -l` prints what it would change and exits 0 either way, so the check
# is on its output, not its status. Every file in the tree, not just the ones
# this change touched.
FMT_CHECK_CMD = test -z "$$(gofmt -l .)" || { echo "not gofmt'd:"; gofmt -l .; exit 1; }
CLEAN_CMD     = go clean ./... && rm -rf dist
